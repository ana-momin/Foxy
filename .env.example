# ============================================================================
# Bellwether - YC Launch Monitor
# Copy this file to `.env` and fill in the values.
#
# ONLY THE SLACK SECTION IS REQUIRED. Everything else is optional and simply
# upgrades the bot from "free mode" to "higher recall mode". The bot runs
# perfectly well with nothing but a Slack token.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SLACK  (required)
# ----------------------------------------------------------------------------
# Get these by creating a Slack app from the bundled slack-app-manifest.json.
# See README section "Install the Slack app" - takes about 3 minutes.
SLACK_BOT_TOKEN=

# Where alerts go. Either a channel (#yc-signals) or a user ID for DMs (U01234567).
SLACK_TARGET=#yc-signals


# ----------------------------------------------------------------------------
# 2. STATE  (optional - defaults to a local SQLite file)
# ----------------------------------------------------------------------------
# Leave blank to use ./bellwether.db (fine for a laptop, VPS or Docker volume).
# Set a Postgres URL when hosting somewhere with an ephemeral disk
# (Vercel, Render free tier, Fly). Free Postgres: neon.tech or supabase.com
# DATABASE_URL=postgresql+psycopg://user:pass@host/dbname
DATABASE_URL=


# ----------------------------------------------------------------------------
# 3. X / TWITTER  (optional)
# ----------------------------------------------------------------------------
# free    - search engine discovery + X's free syndication API. No key, no cost.
# twitterapi - twitterapi.io. ~$0.15 per 1,000 tweets. Much better recall.
# none    - disable this source entirely.
X_PROVIDER=free
TWITTERAPI_KEY=


# ----------------------------------------------------------------------------
# 4. LINKEDIN  (optional)
# ----------------------------------------------------------------------------
# free   - search engine discovery of public LinkedIn posts. No key, no cost.
# apify  - Apify cookie-free LinkedIn post search. ~$0.005 per post.
# none   - disable this source entirely.
LINKEDIN_PROVIDER=free
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR=khadinakbar~linkedin-post-search-scraper


# ----------------------------------------------------------------------------
# 5. CLASSIFIER  (optional)
# ----------------------------------------------------------------------------
# Without a key, Bellwether uses its built-in rule engine - which is already
# good. With a key it adds a Claude Haiku pass that catches unusual phrasings.
# Cost is well under $2/month at the default cadence.
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-4-5-20251001


# ----------------------------------------------------------------------------
# 6. POND AGENT  (optional - only needed to publish on Pond)
# ----------------------------------------------------------------------------
# Any long random string. Must match the Access Key you enter in Pond.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POND_ACCESS_KEY=
# Public HTTPS base URL of this server, e.g. https://bellwether.vercel.app
PUBLIC_BASE_URL=


# ----------------------------------------------------------------------------
# 7. BEHAVIOUR  (optional)
# ----------------------------------------------------------------------------
# How often the sweep runs, in hours. The brief asks for 8.
SCAN_INTERVAL_HOURS=8

# Signals scoring below this go into a daily digest instead of firing
# individually. Raise it if you get too much noise, lower it for more coverage.
MIN_CONFIDENCE=0.55

# On the very first run, do not alert on companies YC added before this many
# days ago. Stops the first sweep spamming hundreds of backfill alerts.
BACKFILL_DAYS=7

# Set to 1 to log alerts to the console instead of posting to Slack.
DRY_RUN=0
